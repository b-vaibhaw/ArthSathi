# Copy to .env and adjust. python-dotenv loads this automatically if you
# add `from dotenv import load_dotenv; load_dotenv()` at the top of
# app/config.py, or export these in your shell before running uvicorn.

LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_S=120
LLM_MAX_TOOL_ITERATIONS=6
LLM_TEMPERATURE=0.4

DB_PATH=arthasathi.db
RAG_INDEX_PATH=rag_index

USE_SENTENCE_EMBEDDINGS=true
USE_LIVE_NEWS=true
USE_LIVE_MARKET_DATA=true

HOST=0.0.0.0
PORT=8000
